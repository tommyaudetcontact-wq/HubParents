function handleWordLists(req){
 if(!['wordLists','wordListSave','wordListArchive','wordListMerge','wordListApply'].includes(req.action))return null;if(!requestParent||requestParent==='legacy')throw Error('Connecte un compte parent.');
 const key='WORD_LISTS_'+requestFamily,props=properties(),library=JSON.parse(props.getProperty(key)||'{"version":0,"lists":[]}');
 if(req.action==='wordLists')return {ok:true,library};
 if(req.version!==library.version)throw Error('Les listes ont changé. Actualise la bibliothèque.');
 const words=values=>{if(!Array.isArray(values)||values.length>100)throw Error('Maximum 100 mots par liste.');const seen=new Set(),out=[];for(const value of values){if(typeof value!=='string'||!value.trim()||value.trim().length>60)throw Error('Mot invalide (60 caractères maximum).');const word=value.trim().normalize('NFC'),stamp=word.toLocaleLowerCase('fr-CA');if(!seen.has(stamp)){seen.add(stamp);out.push(word);}}return out;};
 if(req.action==='wordListSave'){const name=String(req.name||'').trim().slice(0,80);if(!name)throw Error('Nomme ta liste.');const existing=library.lists.find(l=>l.id===req.listId);if(existing){existing.name=name;existing.words=words(req.words);}else{if(library.lists.length>=100)throw Error('Maximum 100 listes.');library.lists.push({id:Utilities.getUuid(),name,words:words(req.words),archived:false});}}
 if(req.action==='wordListArchive'){const list=library.lists.find(l=>l.id===req.listId);if(!list)throw Error('Liste introuvable.');list.archived=req.archived===true;}
 if(req.action==='wordListMerge'){const target=library.lists.find(l=>l.id===req.target),source=library.lists.find(l=>l.id===req.source);if(!target||!source||target.id===source.id)throw Error('Choisis deux listes différentes.');target.words=words(target.words.concat(source.words));}
 if(req.action==='wordListApply'){const list=library.lists.find(l=>l.id===req.listId);if(!list||!Array.isArray(req.children)||!req.children.length||req.children.length>30)throw Error('Choisis une liste et au moins un enfant.');if(typeof req.week!=='string'||!/^\d{4}-\d{2}-\d{2}$/.test(req.week)||BrawlCore.weekOf(req.week)!==req.week)throw Error('Choisis le lundi de la semaine.');if(list.words.length>50)throw Error('Une dictée hebdomadaire peut contenir au maximum 50 mots.');for(const id of [...new Set(req.children)]){const record=profileRecord(id);record.profile=BrawlCore.apply(record.profile,{type:'dictationList',id:Utilities.getUuid(),week:req.week,words:list.words},Utilities.formatDate(new Date(),TZ,'yyyy-MM-dd'),true);saveRecord(record);}}
 library.version++;props.setProperty(key,JSON.stringify(library));return {ok:true,library};
}
