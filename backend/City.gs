/** Authenticated party directory. Movement is broadcast, never saved every frame. */
function cityPublicMember(req){const p=profileRecord(req.player).profile;const key=req.publicKey;if(!key||key.kty!=='EC'||key.crv!=='P-256'||!/^[\w-]{43}$/.test(key.x)||!/^[\w-]{43}$/.test(key.y))throw Error('Clé de partie invalide.');
 const alphabet='ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_',decode=s=>{let n=0n;for(const c of s)n=n*64n+BigInt(alphabet.indexOf(c));if(n%4n)throw Error('Clé non canonique.');return n/4n;},x=decode(key.x),y=decode(key.y),prime=0xffffffff00000001000000000000000000000000ffffffffffffffffffffffffn,b=0x5ac635d8aa3a93e7b3ebbd55769886bc651d06b0cc53b0f63bce3c3e27d2604bn;
 if(x>=prime||y>=prime||(y*y-(x*x*x-3n*x+b))%prime!==0n)throw Error('Clé de partie invalide.');
 return {id:p.id,name:p.name,skin:p.skin,useCustomAppearance:p.useCustomAppearance,appearance:BrawlCore.effectiveAppearance(p),publicKey:{kty:'EC',crv:'P-256',x:key.x,y:key.y,ext:true},seen:Date.now(),vehicle:p.garage?.selected||'',cars:p.garage?.cars||{}};}
function handleCityAction(req){
 if(!String(req.action).startsWith('city'))return null;if(requestParent)throw Error('Choisis un profil enfant.');
 const activity=typeof handleCityActivities==='function'?handleCityActivities(req):null;if(activity)return activity;
 const cache=CacheService.getScriptCache(),now=Date.now();
 if(req.action==='cityDriveStart'){const p=profileRecord(req.player).profile;if(!p.garage?.cars[req.car])throw Error('Voiture indisponible.');const id=Utilities.getUuid();cache.put('drive:'+req.player,JSON.stringify({id,car:req.car,started:now,used:0}),7200);return {ok:true,driveId:id};}
 if(req.action==='cityDriveSave'){const grant=JSON.parse(cache.get('drive:'+req.player)||'null');if(!grant||grant.id!==req.driveId||!Number.isFinite(req.seconds)||req.seconds<0||req.seconds>120||typeof req.requestId!=='string'||req.requestId.length>100)throw Error('Séance de conduite invalide.');const record=profileRecord(req.player);if(record.profile.seen.includes(req.requestId))return {ok:true,profile:publicProfile(record.profile)};if(grant.used+req.seconds>(now-grant.started)/1000+2)throw Error('Durée de conduite invalide.');const event={type:'carUse',car:grant.car,seconds:req.seconds,id:req.requestId};if(!record.profile.seen.includes(event.id)){record.profile=BrawlCore.apply(record.profile,event,Utilities.formatDate(new Date(),TZ,'yyyy-MM-dd'),false);saveRecord(record);grant.used+=req.seconds;cache.put('drive:'+req.player,JSON.stringify(grant),7200);}return {ok:true,profile:publicProfile(record.profile)};}
 if(req.action==='cityPartyCreate'){authThrottle('city-create:'+req.player,12);const member=cityPublicMember(req),id=Utilities.getUuid();let code=null;for(let i=0;i<20;i++){const c=String(parseInt(Utilities.getUuid().replace(/-/g,'').slice(0,8),16)%1000000).padStart(6,'0');if(!cache.get('city-code:'+c)){code=c;break;}}if(!code)throw Error('Réessaie dans quelques instants.');const room={id,code,host:req.player,created:now,members:[member]};cache.put('city:'+id,JSON.stringify(room),120);cache.put('city-code:'+code,id,120);return {ok:true,room};}
 let id=req.roomId;if(req.action==='cityPartyJoin'){authThrottle('city-join:'+req.player,20);if(!/^\d{6}$/.test(req.code||''))throw Error('Entre les 6 chiffres du code.');id=cache.get('city-code:'+req.code);}
 if(typeof id!=='string'||id.length>60)throw Error('Partie introuvable.');const room=JSON.parse(cache.get('city:'+id)||'null');if(!room||!room.members.some(m=>m.id===room.host&&now-m.seen<45000))throw Error('L’hôte a quitté la partie.');room.members=room.members.filter(m=>now-m.seen<45000);
 if(req.action==='cityPartyJoin'){const member=cityPublicMember(req),old=room.members.findIndex(m=>m.id===req.player);if(old<0&&room.members.length>=6)throw Error('Cette partie est complète (6 joueurs).');if(old<0)room.members.push(member);else room.members[old]=member;}
 else{const member=room.members.find(m=>m.id===req.player);if(!member)throw Error('Tu ne fais pas partie de cette partie.');member.seen=now;if(req.action==='cityPartyLeave'){room.members=room.members.filter(m=>m.id!==req.player);if(req.player===room.host)room.members=[];}else if(req.action==='cityPartyPulse'){const p=profileRecord(req.player).profile;member.name=p.name;member.skin=p.skin;member.appearance=BrawlCore.effectiveAppearance(p);member.useCustomAppearance=p.useCustomAppearance;member.vehicle=p.garage?.selected||'';member.cars=p.garage?.cars||{};}else throw Error('Action de partie inconnue.');}
 cache.put('city:'+id,JSON.stringify(room),120);cache.put('city-code:'+room.code,id,120);return {ok:true,room};
}
