/** Résumés publics uniquement ; jamais les profils complets des autres familles. */
function statsDirectory(req){const query=String(req.query||'').trim().toLowerCase();if(query.length>60)throw Error('Recherche trop longue.');const offset=Number(req.offset||0);if(!Number.isInteger(offset)||offset<0||offset>1000000)throw Error('Page invalide.');const stats=[];for(const row of activeDB().getSheetByName('Profils').getDataRange().getValues().slice(1)){if(!row[0])continue;const p=BrawlCore.upgrade(decodeProfile(row[3]));if(!authProfileAllowed(p.id)&&p.shareStats!==true)continue;if(query&&!p.name.toLowerCase().includes(query))continue;stats.push(BrawlCore.publicStats(p));}stats.sort((a,b)=>a.name.localeCompare(b.name,'fr')||a.id.localeCompare(b.id));return {ok:true,stats:stats.slice(offset,offset+30),total:stats.length};}
